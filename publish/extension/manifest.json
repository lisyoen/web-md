{
  "manifest_version": 3,
  "name": "Web Markdown",
  "version": "1.3.0",
  "description": "웹페이지 본문을 LLM 컨텍스트용 Markdown으로 다운로드합니다.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "action": {
    "default_title": "Markdown으로 다운로드",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
